### 小米 CR6608 定制软件包清单 ###
### 以后要加包 / 删包，只改这个文件，不用动 .config 或任何脚本 ###
### 格式与 OpenWrt .config 完全一致：
###   CONFIG_PACKAGE_包名=y               启用
###   # CONFIG_PACKAGE_包名 is not set    关闭
### 其余以 # 开头的都是注释，脚本会自动忽略。

# ---- 主题：argon（并确保 aurora 及其配置插件不存在）----
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
# CONFIG_PACKAGE_luci-theme-aurora is not set
# CONFIG_PACKAGE_luci-app-aurora-config is not set

# ---- 内核模块：ZeroTier 与 EasyTier 都需要 TUN ----
CONFIG_PACKAGE_kmod-tun=y

# ---- 桥接防火墙：nftables bridge + ebtables + br_netfilter ----
CONFIG_PACKAGE_kmod-nft-bridge=y
CONFIG_PACKAGE_kmod-ebtables=y
CONFIG_PACKAGE_kmod-ebtables-ipv4=y
CONFIG_PACKAGE_kmod-ebtables-ipv6=y
CONFIG_PACKAGE_kmod-br-netfilter=y
CONFIG_PACKAGE_ebtables-legacy=y
CONFIG_PACKAGE_ebtables-legacy-utils=y

# ---- EasyTier（noweb = 官方预编译二进制，支持 mipsel，编译快）----
CONFIG_PACKAGE_easytier-noweb=y
CONFIG_PACKAGE_luci-app-easytier=y
# CONFIG_PACKAGE_easytier is not set

# ---- ZeroTier（默认用 mwarning 维护的新版包替换 feeds 旧版，失败自动回退 feeds）----
CONFIG_PACKAGE_zerotier=y
CONFIG_PACKAGE_luci-app-zerotier=y

# ---- OpenClash Mihomo 内核（构建时从官方 core/master 获取）----
CONFIG_PACKAGE_mihomo-core=y

# ---- PassWall 最新核心（插件源码更新，核心用预编译二进制）----
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_xray-bin=y
CONFIG_PACKAGE_sing-box-bin=y
# CONFIG_PACKAGE_xray-core is not set
# CONFIG_PACKAGE_sing-box is not set
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Hysteria=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Geoview=n

# ---- ddns-go ----
CONFIG_PACKAGE_ddns-go=y
CONFIG_PACKAGE_luci-app-ddns-go=y

# ---- FRP（frpc 客户端 + frps 服务端，使用 mipsle 预编译二进制）----
CONFIG_PACKAGE_frpc=y
CONFIG_PACKAGE_frps=y
CONFIG_PACKAGE_luci-app-frpc=y
CONFIG_PACKAGE_luci-app-frps=y

# ---- iStore 应用商店 ----
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-lib-taskd=y
CONFIG_PACKAGE_luci-lib-xterm=y
CONFIG_PACKAGE_taskd=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lua-runtime=y

# ---- wechatpush（微信 / Telegram / 邮件 推送通知）----
CONFIG_PACKAGE_luci-app-wechatpush=y
