# 目标平台配置
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_xiaomi_mi-router-cr6608=y

# 内核配置
CONFIG_KERNEL_BUILD_DOMAIN="CR6608"
CONFIG_KERNEL_BUILD_USER="builder"

# 基础系统
CONFIG_PACKAGE_base-files=y
CONFIG_PACKAGE_busybox=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_firewall4=y
# CONFIG_PACKAGE_fw4 is not set
#   注：fw4 是 firewall4 的 PROVIDES 虚拟名，没有同名真实包，
#   写 CONFIG_PACKAGE_fw4=y 会被 make defconfig 静默丢弃，故注释掉。
# iptables 相关：24.10 里 iptables / ip6tables 都是 PROVIDES 虚拟名，
# 真实包是 iptables-nft（同时提供 iptables 与 ip6tables）。
CONFIG_PACKAGE_iptables-nft=y
# CONFIG_PACKAGE_iptables is not set
# CONFIG_PACKAGE_ip6tables is not set
CONFIG_PACKAGE_iptables-mod-conntrack-extra=y
CONFIG_PACKAGE_iptables-mod-ipopt=y
CONFIG_PACKAGE_kmod-gre=y
CONFIG_PACKAGE_kmod-ipt-conntrack=y
CONFIG_PACKAGE_kmod-ipt-core=y
CONFIG_PACKAGE_kmod-ipt-nat=y
CONFIG_PACKAGE_kmod-nf-conntrack=y
CONFIG_PACKAGE_kmod-nf-nat=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_libc=y
CONFIG_PACKAGE_libgcc=y
CONFIG_PACKAGE_libpthread=y
CONFIG_PACKAGE_librt=y
CONFIG_PACKAGE_libstdcpp=y
CONFIG_PACKAGE_logd=y
CONFIG_PACKAGE_mtd=y
CONFIG_PACKAGE_netifd=y
# nftables 也是 PROVIDES 虚拟名，真实包为 nftables-json（firewall4 会自行拉入）
# CONFIG_PACKAGE_nftables is not set
CONFIG_PACKAGE_nftables-json=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_opkg=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_procd=y
CONFIG_PACKAGE_rpcd=y
CONFIG_PACKAGE_swconfig=y
CONFIG_PACKAGE_uci=y
CONFIG_PACKAGE_uclient-fetch=y
CONFIG_PACKAGE_urandom-seed=y
CONFIG_PACKAGE_urngd=y
CONFIG_PACKAGE_usign=y
CONFIG_PACKAGE_wpad-basic-mbedtls=y

# SSL 后端：libustream-ssl 的三个变体(openssl/mbedtls/wolfssl)都会安装
# 同一个文件 /lib/libustream-ssl.so，Makefile 里带 CONFLICTS，只能选一个。
# 而 immortalwrt 的 include/target.mk 把 libustream-openssl 写进了 DEFAULT_PACKAGES
# 会强制选中它，与下面的 mbedtls 冲突，导致 package/install 阶段报
# check_data_file_clashes（Error 255/2）。
# 解决：diy-part2.sh 会把 libustream-openssl 从 DEFAULT_PACKAGES 中删除，
#      这里再显式声明一次，保证全局只有 mbedtls 一个变体。
CONFIG_PACKAGE_libustream-mbedtls=y
# CONFIG_PACKAGE_libustream-openssl is not set
# CONFIG_PACKAGE_libustream-wolfssl is not set

# LuCI Web界面
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lib-base=y
CONFIG_PACKAGE_luci-lib-ip=y
CONFIG_PACKAGE_luci-lib-jsonc=y
CONFIG_PACKAGE_luci-lib-nixio=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_rpcd-mod-rrdns=y

# Argon主题
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y

# ZeroTier
CONFIG_PACKAGE_zerotier=y
CONFIG_PACKAGE_luci-app-zerotier=y

# DDNSTO
# CONFIG_PACKAGE_ddnsto is not set
# CONFIG_PACKAGE_luci-app-ddnsto is not set

# PassWall
CONFIG_PACKAGE_luci-app-passwall=y
# CONFIG_PACKAGE_luci-app-passwall2 is not set
CONFIG_PACKAGE_chinadns-ng=y
CONFIG_PACKAGE_dns2socks=y
CONFIG_PACKAGE_dns2tcp=y
# CONFIG_PACKAGE_hysteria is not set
CONFIG_PACKAGE_ipt2socks=y
CONFIG_PACKAGE_microsocks=y
# CONFIG_PACKAGE_naiveproxy is not set
# 注：pdnsd-alt 在 24.10 的 feeds 里已不存在（passwall 25.x 不再依赖它），
#     写了也会被静默丢弃，故注释掉。
CONFIG_PACKAGE_shadowsocks-rust-sslocal=y
# CONFIG_PACKAGE_shadowsocks-libev-ss-local is not set
# CONFIG_PACKAGE_shadowsocks-libev-ss-redir is not set
#   注：shadowsocks-libev-ss-* 在 24.10 feeds 里已无对应包，
#   passwall 实际使用 shadowsocks-rust-sslocal（见上），libev 项仅作历史保留。
# CONFIG_PACKAGE_shadowsocks-libev-ss-server is not set
# CONFIG_PACKAGE_shadowsocks-rust-ssserver is not set
# CONFIG_PACKAGE_simple-obfs-client is not set
CONFIG_PACKAGE_tcping=y
# CONFIG_PACKAGE_trojan-go is not set
# CONFIG_PACKAGE_trojan-plus is not set

# 核心选择：保留 xray-core，移除 v2ray-core
# 说明：openwrt-24.10 分支自带的 golang 版本为 1.23.12，
#       passwall feed 中的 Xray-core 26.x 的 go.mod 要求 go >= 1.27，编译会失败。
#       因此在 feeds 处理阶段删除 passwall 的重复定义，
#       实际编译的是 immortalwrt 官方 packages 中的 net/xray-core (25.2.21, go 1.23)。
#       详见 .github/workflows/build.yml 的 "处理重复包" 步骤。
CONFIG_PACKAGE_xray-core=y
# CONFIG_PACKAGE_v2ray-core is not set
# geo 数据包：xray/passwall 的路由规则需要 geoip.dat / geosite.dat。
# 注意：v2ray-geodata 只是 PROVIDES 虚拟名（没有同名真实包），
# 写 CONFIG_PACKAGE_v2ray-geodata=y 会被 make defconfig 静默丢弃，
# 真实包名是 v2ray-geoip 与 v2ray-geosite。
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y
# CONFIG_PACKAGE_v2ray-geodata is not set
# CONFIG_PACKAGE_v2ray-geosite-ir is not set
# CONFIG_PACKAGE_v2ray-plugin is not set
# CONFIG_PACKAGE_brook is not set
# CONFIG_PACKAGE_sing-box is not set

# OpenClash
CONFIG_PACKAGE_luci-app-openclash=y

# 应用商店 iStore
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-lib-taskd=y
# 注：luci-lib-tools 在 24.10 feeds 里不存在，会被静默丢弃，故注释掉
# CONFIG_PACKAGE_luci-lib-tools is not set
CONFIG_PACKAGE_taskd=y

# 网络工具
CONFIG_PACKAGE_curl=y
# wget 是 PROVIDES 虚拟名，真实包是 wget-ssl / wget-nossl
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_vim-fuller=y
CONFIG_PACKAGE_htop=y
# CONFIG_PACKAGE_iperf3 is not set
CONFIG_PACKAGE_iputils-ping=y
CONFIG_PACKAGE_iputils-tracepath=y
# CONFIG_PACKAGE_arp-scan is not set
# CONFIG_PACKAGE_ethtool is not set
# CONFIG_PACKAGE_ifstat is not set
# CONFIG_PACKAGE_nload is not set
# tc 是 PROVIDES 虚拟名，真实包是 tc-full / tc-tiny
CONFIG_PACKAGE_tc-full=y
# CONFIG_PACKAGE_tcpdump-mini is not set

# 磁盘工具
# CONFIG_PACKAGE_block-mount is not set
# CONFIG_PACKAGE_e2fsprogs is not set
# CONFIG_PACKAGE_fdisk is not set
# CONFIG_PACKAGE_lsblk is not set
# CONFIG_PACKAGE_blkid is not set
# CONFIG_PACKAGE_parted is not set
# CONFIG_PACKAGE_usbutils is not set
# CONFIG_PACKAGE_kmod-fs-ext4 is not set
# CONFIG_PACKAGE_kmod-fs-vfat is not set
# CONFIG_PACKAGE_kmod-nls-cp437 is not set
# CONFIG_PACKAGE_kmod-nls-iso8859-1 is not set
# CONFIG_PACKAGE_kmod-nls-utf8 is not set
# CONFIG_PACKAGE_kmod-usb-core is not set
# CONFIG_PACKAGE_kmod-usb-ohci is not set
# CONFIG_PACKAGE_kmod-usb-storage is not set
# CONFIG_PACKAGE_kmod-usb-uhci is not set
# CONFIG_PACKAGE_kmod-usb2 is not set

# 常用服务
# CONFIG_PACKAGE_openvpn-openssl is not set
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_kmod-wireguard=y
# 注：dynamic-dns-luci 是旧名，24.10 里对应 luci-app-ddns（见下），故不再单独写
CONFIG_PACKAGE_luci-app-ddns=y
# dynamic-dns 相关（luci-app-ddns 会自动拉入 ddns-scripts / ddns-scripts-services）
CONFIG_PACKAGE_luci-app-upnp=y
# miniupnpd 是 PROVIDES 虚拟名，24.10 的真实包是 miniupnpd-nftables
CONFIG_PACKAGE_miniupnpd-nftables=y
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_etherwake=y
# CONFIG_PACKAGE_luci-app-sqm is not set
# CONFIG_PACKAGE_sqm-scripts is not set
# CONFIG_PACKAGE_luci-app-adbyby-plus is not set
# CONFIG_PACKAGE_adbyby is not set
# AdGuard Home：
#   1) 真实包名是小写 adguardhome（写成 AdGuardHome 会被静默丢弃）
#   2) luci-app-adguardhome 只存在于 immortalwrt/luci 的 master 分支，
#      openwrt-24.10 分支没有这个包，无法随固件编译，故注释掉。
#      刷机后可用 AdGuard Home 自带的 Web 面板（默认 http://192.168.1.1:3000）管理。
CONFIG_PACKAGE_adguardhome=y
# CONFIG_PACKAGE_luci-app-adguardhome is not set

# 硬件加速
CONFIG_PACKAGE_kmod-nft-offload=y
#   注：kmod-flow-offload 在 24.10 由 kmod-nft-offload 承担，无同名包
# CONFIG_PACKAGE_kmod-flow-offload is not set

# 其他
CONFIG_PACKAGE_zoneinfo-asia=y
CONFIG_PACKAGE_zoneinfo-core=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
#   注：opkg 的 LuCI 界面在 24.10 已由 luci-app-package-manager 承担，
#   luci-i18n-opkg-zh-cn 无对应包，对应用 luci-i18n-package-manager-zh-cn
# CONFIG_PACKAGE_luci-i18n-opkg-zh-cn is not set

# 编译选项
CONFIG_DEVEL=y
CONFIG_CCACHE=y
CONFIG_BUILD_PATENTED=y
CONFIG_BUILD_NLS=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-netlink-diag=y
